# Copy the image references and COMMIT from the selected successful release's
# release.env, then fill in host values and secrets in Portainer. Docker
# administrators can inspect stack environment values.
APP_DOMAIN=app.example.invalid
FILES_DOMAIN=files.example.invalid
APP_ORIGIN=https://app.example.invalid
FILES_PUBLIC_ENDPOINT=https://files.example.invalid
# Ask the Swarm administrator for an unused subnet that does not overlap any
# existing network. Only the frontend and API join this trusted proxy network.
PROXY_NETWORK=172.31.0.0/24
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
MINIO_ROOT_USER=REPLACE_WITH_A_UNIQUE_VALUE
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
MINIO_APP_USER=REPLACE_WITH_A_UNIQUE_VALUE
MINIO_APP_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
FRONTEND_IMAGE=REPLACE_FROM_RELEASE_ENV
API_IMAGE=REPLACE_FROM_RELEASE_ENV
MINIO_BOOTSTRAP_IMAGE=REPLACE_FROM_RELEASE_ENV
BACKUP_TOOLS_IMAGE=REPLACE_FROM_RELEASE_ENV
POSTGRES_IMAGE=postgres:17.11-alpine3.24@sha256:266d3c257594e195b309ae9d1805e54c788f1d7b375f56bf6c367aac6c917e7b
MINIO_IMAGE=REPLACE_FROM_RELEASE_ENV
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727
COMMIT=REPLACE_FROM_RELEASE_ENV
RACLETTY_STACK_NAME=racletty-production
AGE_RECIPIENT=
BACKUP_REMOTE=
RCLONE_CONFIG_CONTENT=
