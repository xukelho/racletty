# Build with the repository root as the context so the shared Workshop styles
# in "Frontend 2" remain available.
FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS build
WORKDIR /src/Frontend
COPY Frontend/package.json Frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY Frontend/ ./
COPY ["Frontend 2", "/src/Frontend 2"]
ARG VITE_GOOGLE_MAPS_API_KEY=
ENV VITE_GOOGLE_MAPS_API_KEY=${VITE_GOOGLE_MAPS_API_KEY}
RUN npm run build

FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5
ARG VITE_GOOGLE_MAPS_API_KEY=
ARG CADDY_CONFIG=deploy/Caddyfile
COPY --from=build /src/Frontend/dist /srv
COPY ${CADDY_CONFIG} /etc/caddy/Caddyfile
EXPOSE 80 443
